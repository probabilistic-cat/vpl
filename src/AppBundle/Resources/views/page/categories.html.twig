{% extends "@App/layout.html.twig" %}
{% use "@App/pieces.html.twig" %}

{% block body %}
    {{ parent() }}
    <div class="wrapper py-5">
        <nav>
            <div class="row align-items-center">
                <div class="col-12 col-md-4 flex-grow-0 flex-md-grow-1">
                    <a class="navbar-brand pb-0" href="{{ path('app_index') }}">
                        <img src="{{ asset('assets/images/logo.svg') }}" alt="Logo" width="50" height="70"/>
                    </a>
                </div>
                <div class="col mt-5 mt-md-0">
                    <div class="row">
                    {% with {
                        'firstDivClass': 'col-6',
                        'secondDivClass': 'col-6',
                      } %}
                        {{ block('categories_in_two_divs') }}
                    {% endwith %}
                    </div>
                </div>
            </div>
        </nav>
    </div>

    <div class="wrapper showcase showcase-categories">
    {% with {
        'elements': categories,
        'route': 'app_category',
        'insertDescBlock': true,
        'elsName': 'Produkte',
        'elsDesc': 'The elegant, clean-cut flat roof is a perfect fit for the minimalist architecture of contemporary living concepts. On request, the flat roof can be combined with a glass dome or an inset glass flat roof to let in even more light.',
      } %}
        {{ block('squares') }}
    {% endwith %}
    </div>

    {{ block('footer_small') }}

{% endblock %}
