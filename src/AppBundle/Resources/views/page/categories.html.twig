{% extends "@App/page/layout.html.twig" %}
{% use "@App/page/pieces.html.twig" %}

{% block body %}
    {{ parent() }}
    <div class="wrapper py-5">
        <nav>
            <div class="row align-items-center">
                <div class="col-12 col-md-4 flex-grow-0 flex-md-grow-1">
                    <a class="navbar-brand pb-0" href="{{ path('app_index') }}">
                        <img src="{{ asset('assets/images/logo.svg') }}" alt="Logo" width="50" height="70"/>
                    </a>
                </div>
                <div class="col mt-5 mt-md-0">
                    <div class="row">
                    {% with {
                        'firstDivClass': 'col-6',
                        'secondDivClass': 'col-6',
                      } %}
                        {{ block('categories_in_two_divs') }}
                    {% endwith %}
                    </div>
                </div>
            </div>
        </nav>
    </div>

    <div class="wrapper showcase showcase-categories">
    {% with {
        'elements': categories,
        'route': 'app_category',
        'insertDescBlock': true,
        'elsName': 'Produkte',
        'elsDesc': 'Heute können wir Ihnen 30  verschiedene Fenster- und  Türsysteme aus PVC, Aluminium  und Holz anbieten. Wir erweitern  unser Angebot immer weiter. Wir bieten auch Schiebesysteme und Rollläden an. Alles in höhster  Qualität, dank Materialien von  renommierten Lieferanten aus  ganz Europa.',
      } %}
        {{ block('squares') }}
    {% endwith %}
    </div>

    {{ block('footer_small') }}

{% endblock %}
