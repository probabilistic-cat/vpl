{% extends "@App/page/layout.html.twig" %}
{% use "@App/page/pieces.html.twig" %}

{% block body %}
    {{ parent() }}
    <div class="wrapper py-5">
        <nav>
            <div class="row align-items-center">
                <div class="col-12 col-md-4 flex-grow-0 flex-md-grow-1">
                    <a class="navbar-brand pb-0" href="{{ path('app_index') }}">
                        <img src="{{ asset('assets/images/logo.svg') }}" alt="Logo" width="50" height="70"/>
                    </a>
                </div>
                <div class="col mt-5 mt-md-0">
                    <div class="row">
                        <div class="col">
                            <ul class="catalog-breadcrumbs">
                                <li><a href="{{ path('app_categories') }}">Produkte:</a></li>
                                <li><a href="{{ path('app_category', {'id': subcategory.category.id}) }}">{{ subcategory.category.name }}:</a></li>
                                <li>{{ subcategory.name }}</li>
                            </ul>
                            <div class="vendor-filter my-4 grayscale">
                                <div class="vendor-filter-title">Wählen:</div>
                                {% for manufacturer in manufacturers %}
                                    {% set vendorFilterClass = '' %}
                                    {% if selectedManufacturerId == manufacturer.id %}
                                        {% set vendorFilterClass = 'active' %}
                                    {% endif %}
                                    <a href="{{ path('app_subcategory', {'id': subcategory.id, 'manufacturer': manufacturer.id}) }}" class="{{ vendorFilterClass }}">
                                        <img src="{{ asset(manufacturer.img) }}">
                                    </a>
                                {% endfor %}
                                <a href="{{ path('app_subcategory', {'id': subcategory.id}) }}">All</a>
                            </div>
                            <ul class="nav nav-submenu flex-row">
                            {% for product in products %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_product', {'id': product.id}) }}">{{ product.name }}</a>
                                </li>
                            {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </div>

    <div class="wrapper showcase showcase-products" data-color="{{ subcategory.category.color }}">
    {% with {
        'elements': products,
        'route': 'app_product',
        'insertDescBlock': false,
        'elsName': subcategory.name,
        'elsDesc': subcategory.description,
      } %}
        {{ block('squares') }}
    {% endwith %}
    </div>

    {{ block('footer_small') }}

{% endblock %}
