{% block header %}
    <div class="wrapper pt-4">
        <nav class="navbar navbar-expand-xl navbar-light px-0">
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand d-block d-xl-none mx-auto" href="{{ path('app_index') }}">
                <img src="{{ asset('assets/images/logo-base.svg') }}" alt="Logo" width="43" height="34">
            </a>
            <div class="collapse navbar-collapse align-items-end flex-wrap" id="navbarCollapse">
                <div class="navbar-nav flex-shrink-0">
                {% for category in categories %}
                    <div class="navbar-item dropdown">
                        <a class="nav-link dropdown-toggle" id="navbar-dropdown" href="{{ path('app_category', {'id': category.id}) }}" title="{{ category.name }}" role="button" data-toggle="dropdown">{{ category.name }}</a>
                        <div class="dropdown-menu">
                        {% for subcategory in category.subcategories %}
                            <a class="dropdown-item" href="{{ path('app_subcategory', {'id': subcategory.id}) }}">{{ subcategory.name }}</a>
                        {% endfor %}
                        </div>
                    </div>
                {% endfor %}
                    {#<a class="navbar-item nav-link" href="{{ path('app_design') }}" title="{{ misc.designName }}">{{ misc.designName }}</a>#}
                </div>
                <a class="navbar-brand pb-0 text-center d-none d-xl-block" href="{{ path('app_index') }}">
                    <img src="{{ asset('assets/images/logo.svg') }}" alt="Logo" width="50" height="70"/>
                </a>
                <div class="navbar-nav font-weight-bold flex-shrink-1 d-xl-flex justify-content-xl-end">
                {{ block('header_right') }}
                </div>
            </div>
        </nav>
    </div>
{% endblock %}

{% block header_right %}
    {#<a class="navbar-item nav-link" href="#">Partner1</a>#}
    <a class="navbar-item nav-link" href="{{ path('app_design') }}" title="{{ misc.designName }}">{{ misc.designName }}</a>
    <a class="navbar-item nav-link" href="{{ path('app_contact') }}">Kontakt</a>
    <a class="navbar-item nav-link py-0 d-flex align-items-center" href="{{ mainPage.facebook }}" target="_blank">
        <img src="{{ asset('assets/images/logo-fb.svg') }}" width="24" height="24">
    </a>
{% endblock %}


{% block footer_big %}
    <div class="wrapper">
        <footer>
            <div class="d-flex">
                <img class="mr-4" src="{{ asset('assets/images/logo-base.svg') }}" alt="Logo" width="43" height="34">
                <div class="w-100">
                    <hr class="w-100 bg-dark mb-5">
                    <nav>
                        <div class="row">
                            <div class="col-12 col-md-5 col-lg-4">
                                <p class="mt-2 mb-4"><b>{{ mainPage.copyright }}</b></p>
                                <p class="mb-1">
                                    <a class="underlined" href="mailto:{{ mainPage.mail }}">{{ mainPage.mail }}</a>
                                </p>
                                <p class="mb-0">{{ mainPage.phone }}</p>
                                <a class="btn btn-link link-callback pl-0 py-1 font-weight-bold underlined" href="#callbackForm">Rückruf anfordern</a>
                                <p>
                                    <b><a href="#">Partner</a></b>
                                    <span class="mx-4">|</span>
                                    <b><a href="{{ mainPage.facebook }}" target="_blank">Facebook</a></b>
                                </p>
                            </div>
                            {% with {
                                'firstDivClass': 'col-12 col-md-7 col-lg-4',
                                'secondDivClass': 'col-12 col-md-7 offset-md-5 col-lg-4 offset-lg-0',
                              } %}
                                {{ block('categories_in_two_divs') }}
                            {% endwith %}
                        </div>
                    </nav>
                </div>
            </div>
        </footer>
    </div>
{% endblock %}


{% block footer_small %}
    <div class="wrapper">
        <footer>
            <div class="d-flex">
                <img class="mr-4" src="{{ asset('assets/images/logo-base.svg') }}" alt="Logo" width="43" height="34">
                <div class="w-100">
                    <hr class="w-100 bg-dark mb-5">
                    <nav>
                        <div class="row align-items-center">
                            <div class="col-12 col-sm-6">
                                <div class="py-3"><b>{{ mainPage.copyright }}</b></div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <nav class="navbar-expand">
                                    <div class="navbar-nav d-flex flex-row font-weight-bold flex-shrink-1 justify-content-sm-end">
                                        <a class="navbar-item nav-link" href="#">Partner</a>
                                        <a class="navbar-item nav-link" href="{{ path('app_contact') }}">Kontakt</a>
                                        <a class="navbar-item nav-link py-0 d-flex align-items-center" href="{{ asset('#') }}">
                                            <img src="{{ asset('assets/images/logo-fb.svg') }}" width="24" height="24">
                                        </a>
                                    </div>
                                </nav>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>
        </footer>
    </div>
{% endblock %}



{% block categories_in_two_divs %}
    <div class="{{ firstDivClass }}">
    {% set catsCount = categories|length %}
    {% set catsInBlock = (catsCount / 2) + (catsCount % 2) %}
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_design') }}">{{ misc.designName }}</a>
            </li>
        {% set catKey = 0 %}
        {% for category in categories %}
            {% set catKey = catKey + 1 %}
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_category', {'id': category.id}) }}">{{ category.name }}</a>
                <ul class="nav nav-submenu">
                {% for subcategory in category.subcategories %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_subcategory', {'id': subcategory.id}) }}">{{ subcategory.name }}</a>
                    </li>
                {% endfor %}
                </ul>
            </li>
            {% if catKey == catsInBlock %}
        </ul>
    </div>
    <div class="{{ secondDivClass }}">
        <ul class="nav flex-column">
            {% endif %}
        {% endfor %}
        </ul>
    </div>
{% endblock %}


{% block squares %}
    <div class="row align-items-stretch">
    {% set elsCount = elements|length %}
    {% set key = 0 %}
    {% set blocksInLastRow = insertDescBlock ? (elsCount + 1) % 3 : elsCount % 3 %}

    {% if route == 'app_category'%}
        <div class="col">
            <div class="proportional">
                <div class="proportional-inner">
                    <div class="card showcase-item">
                        <a href="{{ path('app_design') }}"><img src="{{ asset(misc.designImg) }}" alt="{{ misc.designName }}"/></a>
                        <div class="card-body">
                            <h5 class="card-title">
                                <a href="{{ path('app_design') }}">{{ misc.designName }}</a>
                            </h5>
                            <div class="card-text">{{ misc.designDescription }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% set key = 1 %}
    {% endif %}

    {% for element in elements %}
        {% set key = key + 1 %}
        <div class="col">
            <div class="proportional">
                <div class="proportional-inner">
                    <div class="card showcase-item">
                        <a href="{{ path(route, {'id': element.id}) }}"><img src="{{ asset(element.img) }}" alt="{{ element.name }}"/></a>
                        <div class="card-body">
                            <h5 class="card-title">
                                <a href="{{ path(route, {'id': element.id}) }}">{{ element.name }}</a>
                            </h5>
                            <div class="card-text">{{ element.description|raw }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% if insertDescBlock %}
        {% if (key == 2) or (elsCount <= 2 and key == elsCount)%}
        <div class="col">
            <div class="card showcase-description justify-content-center mt-md-2 mb-md-5 my-lg-0 w-75 mx-auto">
                <h5 class="card-title">{{ elsName }}</h5>
                <div class="card-text">
                    <p>{{ elsDesc }}</p>
                </div>
            </div>
        </div>
        {% endif %}
    {% endif %}
    {% endfor %}
    </div>
{% endblock %}


{% block feedback %}
    <div class="py-5" id="callbackForm">
        <div class="container-fluid">
            <div class="row">
                <div class="col col-md-10 col-lg-6 mx-auto">
                    <form method="post" action="{{ path('app_feedback') }}">
                        <div class="row mb-4">
                            <div class="col-10 col-md-8 col-lg-6">
                                <h3>Schreiben Sie uns und wir rufen Sie schnellstmöglich zurück:</h3>
                            </div>
                            <div class="col-2 ml-auto text-right">
                                <div class="link-close">&times;</div>
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col"><span class="mr-4">Anrede:</span>
                                <div class="custom-control custom-radio custom-control-inline">
                                    <input class="custom-control-input" id="andere1" type="radio" name="sex" value="Herr" required>
                                    <label class="custom-control-label" for="andere1">Herr</label>
                                </div><span class="px-2"></span>
                                <div class="custom-control custom-radio custom-control-inline">
                                    <input class="custom-control-input" id="andere2" type="radio" name="sex" value="Frau" required>
                                    <label class="custom-control-label" for="andere2">Frau</label>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                <div class="form-group">
                                    <input class="form-control" type="text" placeholder="Vorname" name="first_name" required>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-group">
                                    <input class="form-control" type="text" placeholder="Nachname" name="last_name" required>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                <div class="form-group">
                                    <input class="form-control" type="text" placeholder="+88 (888) 88-88-88" name="phone" required>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-group">
                                    <input class="form-control" type="text" placeholder="Gewünschte Rückrufzeit" name="callback_time" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <textarea class="form-control" placeholder="Ihre Frage" name="text" required></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <button class="btn w-100 text-left" type="submit">Absenden</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}


{% block info_bottoms %}
    {% if elements|length > 0 %}
    <div class="wrapper {{ additionalClasses }}">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
        {% set itemNum = 0 %}
        {% for item in elements %}
            {% set itemNum = itemNum + 1 %}
            {% set id = 'bottom' ~ item.id %}
            {% if itemNum == 1 %}
                {% set tabClass = 'active' %}
            {% else %}
                {% set tabClass = '' %}
            {% endif %}
            <li class="nav-item">
                <a class="nav-link {{ tabClass }}" id="{{ id }}-tab" data-toggle="tab" href="#{{ id }}" role="tab" aria-controls="{{ id }}" aria-selected="true">{{ item.name }}</a>
            </li>
        {% endfor %}
        </ul>
        <div class="tab-content" id="myTabContent">
        {% set itemNum = 0 %}
        {% for item in elements %}
            {% set itemNum = itemNum + 1 %}
            {% set id = 'bottom' ~ item.id %}
            {% if itemNum == 1 %}
                {% set tabClass = 'show active' %}
            {% else %}
                {% set tabClass = '' %}
            {% endif %}
            <div class="tab-pane fade {{ tabClass }}" id="{{ id }}" role="tabpanel" aria-labelledby="{{ id }}-tab">
                {{ item.text|raw }}
            </div>
        {% endfor %}
        </div>
    </div>
    {% endif %}
{% endblock %}