{% extends "@App/layout.html.twig" %}
{% use "@App/pieces.html.twig" %}

{% block body %}
    {{ parent() }}
    <div class="wrapper py-5">
        <nav>
            <div class="row align-items-center">
                <div class="col-12 col-md-4 flex-grow-0 flex-md-grow-1"><a class="navbar-brand pb-0" href="{{ asset('/') }}"><img src="{{ asset('assets/images/logo.svg') }}" alt="Logo" width="50" height="70"/></a></div>
                <div class="col mt-5 mt-md-0">
                    <div class="row">
                        <div class="col">
                            <div class="navbar-nav mb-2">
                                <ul class="catalog-breadcrumbs">
                                    <li><a href="#">Produkte:</a></li>
                                    <li>{{ catWithSubs['category'].name }}</li>
                                </ul>
                            </div>
                            <ul class="nav nav-submenu flex-row">
                            {% for subcategory in catWithSubs['subcategories'] %}
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_subcategory', {'id': subcategory.id}) }}">{{ subcategory.name }}</a></li>
                            {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </div>
    <div class="wrapper showcase showcase-subcategories" data-color="#c9eeff">
        <div class="row align-items-stretch">
        {% set subcats = catWithSubs['subcategories'] %}
        {% set subcatsCount = subcats|length %}
        {% set subcatKey = 0 %}
        {% for subcategory in subcats %}
            {% set subcatKey = subcatKey + 1 %}
            <div class="col-md-6 col-xl-4">
                <div class="card showcase-item"><a href="{{ path('app_subcategory', {'id': subcategory.id}) }}"><img src="{{ asset(subcategory.img) }}" alt="{{ subcategory.name }}"/></a>
                    <div class="card-body">
                        <h5 class="card-title"><a href="{{ path('app_subcategory', {'id': subcategory.id}) }}">{{ subcategory.name }}</a></h5>
                        <div class="card-text">{{ subcategory.description }}</div>
                    </div>
                </div>
            </div>
            {% if (subcatKey == 2) or (subcatsCount <= 2 and subcatKey == subcatsCount)%}
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card showcase-description justify-content-center mt-md-2 mb-md-5 my-lg-0 w-75 mx-auto">
                    <h5 class="card-title">{{ catWithSubs['category'].name }}</h5>
                    <div class="card-text">
                        <p>{{ catWithSubs['category'].description }}</p>
                    </div>
                </div>
            </div>
            {% endif %}
        {% endfor %}

