{% extends "@App/layout.html.twig" %}
{% use "@App/pieces.html.twig" %}

{% block body %}
    {{ parent() }}
    <div class="wrapper py-5">
        <nav>
            <div class="row align-items-center">
                <div class="col-12 col-md-4 flex-grow-0 flex-md-grow-1"><a class="navbar-brand pb-0" href="{{ path('app_index') }}"><img src="{{ asset('assets/images/logo.svg') }}" alt="Logo" width="50" height="70"/></a></div>
                <div class="col mt-5 mt-md-0">
                    <div class="row">
                        <div class="col">
                            <div class="navbar-nav mb-2">
                                <ul class="catalog-breadcrumbs">
                                    <li><a href="{{ path('app_categories') }}">Produkte:</a></li>
                                    <li>{{ catWithSubs['data'].name }}</li>
                                </ul>
                            </div>
                            <ul class="nav nav-submenu flex-row">
                            {% for subcategory in catWithSubs['subcategories'] %}
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_subcategory', {'id': subcategory['data'].id}) }}">{{ subcategory['data'].name }}</a></li>
                            {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </div>

    <div class="wrapper showcase showcase-subcategories" data-color="#c9eeff">
    {% with {
        'elements': catWithSubs['subcategories'],
        'route': 'app_subcategory',
        'insertDescBlock': true,
        'elsName': catWithSubs['data'].name,
        'elsDesc': catWithSubs['data'].description,
      } %}
        {{ block('squares') }}
    {% endwith %}

    {{ block('footer_small') }}

{% endblock %}
