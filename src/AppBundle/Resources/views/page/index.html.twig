{% extends "@App/layout.html.twig" %}
{% use "@App/pieces.html.twig" %}

{% block body %}
    {{ parent() }}

    {% block header %}
        {{ parent() }}
    {% endblock %}

    <div class="py-1 py-md-2"></div>
    <div class="carousel slide px-0" id="carouselMain" data-ride="carousel_disabled" data-interval="0">
        <div class="carousel-inner">
            <div class="carousel-item active"><img class="d-block w-100" src="{{ asset('assets/images/carousel-main/01.jpg') }}" alt="First slide">
                <div class="carousel-caption d-flex align-items-center">
                    <div class="row">
                        <div class="col-sm-10 col-md-9 col-lg-8 mx-auto">
                            <p class="lead mb-0">VPL uses Schüco-brand top-quality thermally isolated aluminium profile systems for its windows and doors. The high-quality window and door elements impress with their elegant details in a slimline, beautiful look.</p>
                            <p class="phone my-1 my-md-3 my-lg-5">+88 159 85 9253</p>
                            <button class="btn btn-lg btn-outline-dark link-callback px-md-5 py-md-3 px-3 py-2" type="button">Обратный звонок</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item"><img class="d-block w-100" src="{{ asset('assets/images/carousel-main/02.jpg') }}" alt="Second slide">
                <div class="carousel-caption d-flex align-items-center justify-content-center">
                    <div class="jumbotron w-75" style="background-color: rgba(255, 255, 255, .75);">
                        <h2 class="display-4">Some other lead</h2>
                        <p class="lead">List key advantages of your product here</p>
                    </div>
                </div>
            </div><a class="carousel-control-prev" href="#carouselMain" role="button" data-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="sr-only">Previous</span></a><a class="carousel-control-next" href="#carouselMain" role="button" data-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="sr-only">Next</span></a>
        </div>
    </div>
    <div class="bg-light" id="callbackFront">
        <div class="py-5" id="callbackForm">
            <div class="container-fluid">
                <div class="row">
                    <div class="col col-md-10 col-lg-6 mx-auto">
                        <form>
                            <div class="row mb-4">
                                <div class="col-10 col-md-8 col-lg-6">
                                    <h3>Schreiben Sie uns und wir rufen Sie schnellstmöglich zurück:</h3>
                                </div>
                                <div class="col-2 ml-auto text-right">
                                    <div class="link-close">&times;</div>
                                </div>
                            </div>
                            <div class="row mb-4">
                                <div class="col"><span class="mr-4">Andere:</span>
                                    <div class="custom-control custom-radio custom-control-inline">
                                        <input class="custom-control-input" id="andere1" type="radio" name="andere" value="herr">
                                        <label class="custom-control-label" for="andere1">Herr</label>
                                    </div><span class="px-2"></span>
                                    <div class="custom-control custom-radio custom-control-inline">
                                        <input class="custom-control-input" id="andere2" type="radio" name="andere" value="frau">
                                        <label class="custom-control-label" for="andere2">Frau</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <div class="form-group">
                                        <input class="form-control" type="text" placeholder="Vorname" name="vorname">
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <input class="form-control" type="text" placeholder="Nachname" name="nachname">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <div class="form-group">
                                        <input class="form-control" type="text" placeholder="+88 (888) 88-88-88" name="phone">
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <input class="form-control" type="text" placeholder="Gewünschte Rückrufzeit" name="gewunschte-ruckrufzeit">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <textarea class="form-control" placeholder="Ihre frage" name="ihre-frage"></textarea>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <button class="btn w-100 text-left" type="submit">Absenden</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="d-none d-md-block py-5"></div>
    <div class="wrapper my-2 my-md-5">
        <div class="row my-5 align-items-stretch">
            <div class="col-md-6 col-xl-4">
                <div class="card showcase-item py-0" style="background-color: #f4f6b5;"><img src="{{ asset('assets/images/products/mb-45.png') }}" width="134" height="232" alt="MB-45">
                    <div class="card-body">
                        <h5 class="card-title">MB-45</h5>
                        <div class="card-text">MB-45 kann zum Bau von Außenelementen dienen, aber nur dort, wo keine Thermoisolierung erforderlich ist.</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4 text-center"><img class="img-fluid w-100 my-3 my-md-0" src="{{ asset('assets/images/main/mb-45-installed.jpg') }}" alt="MB-45 installed"></div>
            <div class="col-12 col-xl-4">
                <div class="card showcase-description justify-content-center my-3 my-sm-4 my-md-5 my-xl-0 w-75 mx-auto">
                    <h5 class="card-title">Minimalism</h5>
                    <div class="card-text columns-md-2">
                        <p>The elegant, clean-cut flat roof is a perfect fit for the minimalist architecture of contemporary living concepts. On request, the flat roof can be combined with a glass dome or an inset glass flat roof to let in even more light.</p>
                        <p>The VPL® thus achieves outstanding energy values at the passive house level. Along with low energy use, this also provides a pleasant living atmosphere at all times of the year.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="py-2 py-md-5 d-none d-lg-block"></div>
        <div class="card showcase-item my-5" style="background-color: #e4d4ff;"><img src="{{ asset('assets/images/products/pcv-tur.png') }}" width="164" height="265" alt="PCV-Tur">
            <div class="card-body">
                <h5 class="card-title">PCV-Tür</h5>
                <div class="card-text">
                    <div class="row">
                        <div class="col-md-6 mx-auto">MB-45 kann zum Bau von Außenelementen dienen, aber nur dort, wo keine Thermoisolierung erforderlich ist.</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="py-5 d-none d-lg-block"></div>
        <div class="row mt-2 mt-md-5">
            <div class="col-12 col-xl-4">
                <div class="card showcase-description mb-3 mb-lg-0 w-75 mx-auto">
                    <h5 class="card-title">Zusätze</h5>
                    <div class="card-text pb-2 columns-md-2">
                        <p>Ein wesentlicher Bestandteil der Alufenster, der Funktionalität und Ästhetik beeinflusst, sind zweifellos Zusätze.</p>
                        <p>Wir bieten ein breites Spektrum von Zusätzen, u. a. Fenstergriffe, Handgriffe, Oberlichtschließer an.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="card showcase-description"><img class="card-img-top" src="{{ asset('assets/images/main/description-01.jpg') }}" alt="Descrption 1">
                    <div class="w-75 mx-auto mx-md-0">
                        <h5 class="card-title">lackierte Fenstergriffe</h5>
                        <div class="card-text">Um die Optik des Fensters noch vorteilhafter erscheinen zu lassen, bieten wir Ihnen lackierte Fenstergriffe an. </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="card showcase-description mt-5 mt-md-0"><img class="card-img-top" src="{{ asset('assets/images/main/description-02.jpg') }}" alt="Descrption 2">
                    <div class="w-75 mx-auto mx-md-0">
                        <h5 class="card-title">Verbund-Sicherheitsglas</h5>
                        <div class="card-text">Die sichere Benutzung wird durch Verbund-Sicherheitsglas (VSG) gewährleistet.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ block('footer_big') }}

{% endblock %}
