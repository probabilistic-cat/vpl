{% extends "@App/layout.html.twig" %}
{% use "@App/pieces.html.twig" %}

{% block body %}
    {{ parent() }}
    {{ block('header') }}

    <div class="py-1 py-md-2"></div>
    <div class="carousel slide px-0" id="carouselMain" data-ride="carousel_disabled" data-interval="0">
        <div class="carousel-inner">
    {% for mainPageImage in mainPageImages %}
        {% if mainPageImage.seq == 1 %}
            <div class="carousel-item active">
                <img class="d-block w-100" src="{{ asset(mainPageImage.img) }}" alt="Slide {{ mainPageImage.seq }}">
                <div class="carousel-caption d-flex align-items-center">
                    <div class="row">
                        <div class="col-sm-10 col-md-9 col-lg-8 mx-auto">
                            <p class="lead mb-0">{{ mainPageImage.text }}</p>
                            <p class="phone my-1 my-md-3 my-lg-5">{{ mainPage.phone }}</p>
                            {#<button class="btn btn-lg btn-outline-dark link-callback px-md-5 py-md-3 px-3 py-2" type="button">Rückruf</button>#}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="carousel-item">
                <img class="d-block w-100" src="{{ asset(mainPageImage.img) }}" alt="Slide {{ mainPageImage.seq }}">
                <div class="carousel-caption d-flex align-items-center justify-content-center">
                    <div class="jumbotron w-75 mb-0" style="background-color: rgba(255, 255, 255, .75);">
                        <h2 class="display-4">{{ mainPageImage.header }}</h2>
                        <p class="lead">{{ mainPageImage.text }}</p>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}}
            <a class="carousel-control-prev" href="#carouselMain" role="button" data-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="carousel-control-next" href="#carouselMain" role="button" data-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </a>
        </div>
    </div>
    <div class="bg-light" id="callbackFront">
    {{ block('feedback') }}
    </div>
    <div class="d-none d-md-block py-5"></div>
    <div class="wrapper my-2 my-md-5">
        <div class="row my-5 align-items-stretch">
            <div class="col-md-6 col-xl-4">
                <div class="card showcase-item py-0" style="background-color: {{ mainPage.secondLine1.subcategory.category.color }};">
                    <img src="{{ asset(mainPage.secondLine1.img) }}" width="134" height="232" alt="{{ mainPage.secondLine1.name }}">
                    <div class="card-body">
                        <h5 class="card-title">{{ mainPage.secondLine1.name }}</h5>
                        <div class="card-text">{{ mainPage.secondLine1.description|raw }}</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4 text-center">
                <img class="img-fluid w-100 my-3 my-md-0" src="{{ asset(mainPage.secondLine2Img) }}">
            </div>
            <div class="col-12 col-xl-4">
                <div class="card showcase-description justify-content-center my-3 my-sm-4 my-md-5 my-xl-0 w-75 mx-auto">
                    <h5 class="card-title">{{ mainPage.secondLine3Header }}</h5>
                    <div class="card-text columns-md-2">{{ mainPage.secondLine3Text|raw }}</div>
                </div>
            </div>
        </div>
        <div class="py-2 py-md-5 d-none d-lg-block"></div>
        <div class="card showcase-item my-5" style="background-color: {{ mainPage.thirdLine1.subcategory.category.color }};">
            <img src="{{ asset(mainPage.thirdLine1.img) }}" width="164" height="265" alt="{{ mainPage.thirdLine1.name }}">
            <div class="card-body">
                <h5 class="card-title">{{ mainPage.thirdLine1.name }}</h5>
                <div class="card-text">
                    <div class="row">
                        <div class="col-md-6 mx-auto">{{ mainPage.thirdLine1.description|raw }}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="py-5 d-none d-lg-block"></div>
        <div class="row mt-2 mt-md-5">
            <div class="col-12 col-xl-4">
                <div class="card showcase-description mb-3 mb-lg-0 w-75 mx-auto">
                    <h5 class="card-title">{{ mainPage.fourthLine1Header }}</h5>
                    <div class="card-text pb-2 columns-md-2">{{ mainPage.fourthLine1Text|raw }}</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="card showcase-description">
                    <img class="card-img-top" src="{{ asset(mainPage.fourthLine2Img) }}">
                    <div class="w-75 mx-auto mx-md-0">
                        <h5 class="card-title">{{ mainPage.fourthLine2Header }}</h5>
                        <div class="card-text">{{ mainPage.fourthLine2Text }}</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="card showcase-description mt-5 mt-md-0">
                    <img class="card-img-top" src="{{ asset(mainPage.fourthLine3Img) }}">
                    <div class="w-75 mx-auto mx-md-0">
                        <h5 class="card-title">{{ mainPage.fourthLine3Header }}</h5>
                        <div class="card-text">{{ mainPage.fourthLine3Text }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ block('footer_big') }}

{% endblock %}
