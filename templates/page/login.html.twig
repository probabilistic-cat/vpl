{% if error %}
    <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
{% endif %}

<div class="sign_form">
    <form id="sign_form" action="{{ path('app_login') }}" method="post">
        <input id="username" class="sign_element" type="text" name="_username" value="{{ last_username }}"
               placeholder="Username" />
        <input id="password" class="sign_element" type="password" name="_password" placeholder="Password" />
        <input type="submit" value="Log in">
    </form>
</div>
